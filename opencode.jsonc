{
  "$schema": "https://opencode.ai/config.json",

  // ==========================================================================
  // 1) الحدود (LIMITS) — قواعد صارحة ومرتّبة.
  //    القاعدة: آخر قاعدة مطابقة هي اللي تُطبّق.
  //    الافتراضي في OpenCode: أي حاجة مالهاش قاعدة = "اسأل".
  // ==========================================================================
  "permissions": [
    // --- الأوامر(shell) ---
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    // push needs human approval in the moment it happens.
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },

    // --- الملفات ---
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // --- البرّا: لازم إذن ---
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // --- الإنترنت ---
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },

    // --- الأسئلة والوكيل الفرعي ---
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "ask" },

    // --- الـ Skills: الافتراضي مسموح، والمحظور صريح ---
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "internal-*", "effect": "deny" },
  ],

  // ==========================================================================
  // 2) موديلات مجانية — أي API متوافق مع OpenAI يشتغل هنا بدون كود.
  //    غيّر المفتاح بس في متغير البيئة، الكود ما بيتغيرش.
  // ==========================================================================
  "providers": {
    // --- OpenRouter (موديلات :free — الـ IDs متحقق منها من API في أكتوبر 2026) ---
    // كل الموديلات دي بتدعم tool calling (شرط أساسي لوكيل برمجة).
    "openrouter-free": {
      "name": "OpenRouter (Free)",
      "env": ["OPENROUTER_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "https://openrouter.ai/api/v1" },
      "models": {
        // أقوى موديل برمجة مجاني حاليًا — 70.2% على Terminal-Bench 2.1
        "laguna-s": {
          "name": "Laguna S 2.1 (coding)",
          "modelID": "poolside/laguna-s-2.1:free",
        },
        // مُدرَّب صراحةً على وكيلات زي OpenCode — سياق 256K
        "north-mini-code": {
          "name": "North Mini Code (coding)",
          "modelID": "cohere/north-mini-code:free",
        },
        // سياق 1M — مناسب للمهام الطويلة
        "nemotron-3-ultra": {
          "name": "Nemotron 3 Ultra (1M ctx)",
          "modelID": "nvidia/nemotron-3-ultra-550b-a55b:free",
        },
        // راوتر بيختار موديل مجاني تلقائيًا حسب المهمة
        "free-router": {
          "name": "Free Router (auto)",
          "modelID": "openrouter/free",
        },
      },
    },

    // --- Groq (سريع جدًا) ---
    // ملاحظة: llama-3.3-70b-versatile اتلغي في 08/2026 — الاستبدال الرسمي مكتوب هنا.
    "groq-free": {
      "name": "Groq",
      "env": ["GROQ_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "https://api.groq.com/openai/v1" },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "modelID": "openai/gpt-oss-120b",
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B",
          "modelID": "qwen/qwen3.8-27b",
        },
      },
    },

    // --- Google Gemini (التوافق مع OpenAI) ---
    // gemini-2.5-flash مقيّد للعملاء القدام — الحالي 3.8.
    "gemini-free": {
      "name": "Gemini",
      "env": ["GEMINI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
      },
      "models": {
        "gemini-3.8-flash": { "name": "Gemini 3.8 Flash" },
        "gemini-3.6-flash": { "name": "Gemini 3.6 Flash" },
      },
    },

    // --- Ollama (محلي — صفر توكنز، صفر إنترنت) ---
    "ollama-local": {
      "name": "Ollama (Local)",
      "env": [],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:11434/v1" },
      "models": {
        "qwen3-coder-local": { "name": "Qwen3 Coder (local)" },
      },
    },
  },

  // ==========================================================================
  // 3) الـ Skills — مستودع بيتحدّث تلقائيًا من غير ما نلمس الكود.
  //    محليًا: مجلد على القرص (يتحدّث بـ git pull).
  //    للنشر: غيّره لـ https://raw.githubusercontent.com/<user>/<repo>/<branch>/skills-hub/
  //           وهو HTTP catalog بـ index.json — التحديث بزيادة "version" فقط.
  //           (الفرع عندنا master وليس main)
  "skills": ["https://raw.githubusercontent.com/forwe7939-tech/agent-profile/master/skills-hub/"],

  // ==========================================================================
  // 4) ضبط استهلاك السياق
  // ==========================================================================
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000,
  },

  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200,
  },
}
