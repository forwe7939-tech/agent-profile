# Copy to `.env` and fill in what you have. Leave the rest blank.
# The config file (opencode.jsonc) references these names — it never contains a key.

# OpenRouter — models ending in :free cost nothing
OPENROUTER_API_KEY=

# Groq — fast free tier
GROQ_API_KEY=

# Google AI Studio — Gemini free tier
GEMINI_API_KEY=

# Ollama needs no key. Install from https://ollama.com and pull a model:
#   ollama pull qwen3-coder
